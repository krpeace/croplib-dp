# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 서버(GitHub Actions)에서는 같은 이름을 GitHub Secrets 에 등록한다.

# 공공데이터포털 인증키 (기상청 ASOS 일자료, 단기예보). GitHub Secrets 이름도 같다.
DATA_GO_KR=
# 기상청 API허브 인증키 (지점 표 조회). 지금은 쓰지 않는다 — 지점 정보는 DB stations 표에 있다.
KMA_HUB=

# Supabase (서버 키는 수집기에서만 쓴다. 화면 저장소에는 넣지 않는다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 실패·지연 알림 메일 (선택)
ALERT_EMAIL_TO=
